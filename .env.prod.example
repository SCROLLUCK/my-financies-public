# Production env. Copy to .env.prod and fill real values. Never commit .env.prod.

# Images (published to GitLab's container registry by CI).
IMAGE_OWNER=your-gitlab-namespace
IMAGE_TAG=latest
# Bind to 127.0.0.1 only — a reverse proxy (nginx + TLS) in front is what's
# actually internet-facing; publishing this to every interface would expose
# the app over plain HTTP, bypassing the proxy entirely.
FRONTEND_PORT=127.0.0.1:18080

# Postgres
POSTGRES_DB=financies
POSTGRES_USER=financies
POSTGRES_PASSWORD=CHANGE_ME_strong_password

# Django
DATABASE_URL=postgres://financies:CHANGE_ME_strong_password@db:5432/financies
DJANGO_SECRET_KEY=CHANGE_ME_generate_a_long_random_key
DJANGO_DEBUG=0
# Include "backend" — the whatsapp container calls the API directly via
# http://backend:8000 (not through the domain/nginx), so that internal
# hostname must be allowed too or Django 400s every inbound webhook call.
DJANGO_ALLOWED_HOSTS=your-domain.com,backend
CORS_ALLOWED_ORIGINS=https://your-domain.com
CSRF_TRUSTED_ORIGINS=https://your-domain.com

# The one login this single-user app has. Created once on first boot
# (ensure_superuser management command) — no-op on every boot after that.
DJANGO_SUPERUSER_USERNAME=CHANGE_ME
DJANGO_SUPERUSER_PASSWORD=CHANGE_ME_strong_password
DJANGO_SUPERUSER_EMAIL=

# AI / WhatsApp (later phases). Reminder phone, lead days, and which chat to
# watch are configured from the Settings screen and live in the DB.
ANTHROPIC_API_KEY=
WHATSAPP_GATEWAY_URL=http://whatsapp:3000
BACKEND_URL=http://backend:8000
# Shared secret the gateway sends on /api/wa/inbound/ so only it can call that endpoint.
WA_INBOUND_SECRET=CHANGE_ME_strong_password
PARTNER_WHATSAPP_NAME=
