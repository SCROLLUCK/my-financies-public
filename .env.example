# Postgres
POSTGRES_DB=financies
POSTGRES_USER=financies
POSTGRES_PASSWORD=change-me

# Django
DATABASE_URL=postgres://financies:change-me@db:5432/financies
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
DJANGO_TIME_ZONE=America/Sao_Paulo
CORS_ALLOWED_ORIGINS=http://localhost:15173
CSRF_TRUSTED_ORIGINS=http://localhost:15173

# AI (added in later phases)
ANTHROPIC_API_KEY=

# WhatsApp gateway (Phase 5). Everything else (reminder phone, lead days, which
# chat to watch) is configured from the Settings screen and lives in the DB.
WHATSAPP_GATEWAY_URL=http://whatsapp:3000
# Where the gateway forwards inbound messages (Phase 5b capture) — the backend's own address.
BACKEND_URL=http://backend:8000
# Shared secret the gateway sends on /api/wa/inbound/ so only it can call that endpoint.
WA_INBOUND_SECRET=change-me
# Optional: WhatsApp display name (substring, case-insensitive) that marks an inbound
# message as sent by your partner, so captured expenses are attributed to them.
PARTNER_WHATSAPP_NAME=
